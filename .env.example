# Copy to .env and fill in locally. Never commit .env.
# Every variable is optional: with nothing set, the app runs offline
# (AI_PROVIDER=fake, PayPal features disabled with a banner).

# PayPal REST app credentials (developer dashboard, sandbox app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live". Empty means sandbox.
PAYPAL_ENV=
# ID of the webhook registered for this app (used to verify webhook signatures)
PAYPAL_WEBHOOK_ID=
# "invoice" (Invoicing v2, default) or "order" (Orders v2 payment links)
PAYMENT_PATH=

# AI provider: anthropic, google, openai or fake. Empty means fake (offline, no key).
AI_PROVIDER=
# Model id; empty uses the provider default (see README)
AI_MODEL=
AI_API_KEY=
# Cost and abuse limits for AI routes. Defaults: 2000 output tokens per model call;
# 20 valid AI requests per address per 10 minutes; 20 invalid AI requests per address per
# window; 300 model calls per UTC day (every chat tool step and retry counts).
AI_MAX_OUTPUT_TOKENS=
AI_RATE_LIMIT_PER_IP=
AI_RATE_LIMIT_WINDOW_MINUTES=
AI_INVALID_RATE_LIMIT_PER_IP=
AI_DAILY_CAP=

# Limits on the shared PayPal sandbox account (public demo). Defaults in brackets.
# New proposals per session and per address per window [20]
PROPOSAL_RATE_LIMIT=
# Approvals per session and per address per window [20]
APPROVAL_RATE_LIMIT=
# Requests that read from PayPal, per address per window [60]
PAYPAL_READ_RATE_LIMIT=
# Window in minutes for the three limits above [10]
RATE_LIMIT_WINDOW_MINUTES=
# PayPal write calls per UTC day for the whole server [100]
PAYPAL_DAILY_WRITE_CAP=
# Seconds PayPal list reads (invoices, disputes) are cached [30]
LIST_CACHE_SECONDS=
# Webhook requests per address per minute [30] and for the whole server per minute [120]
WEBHOOK_RATE_LIMIT=
WEBHOOK_GLOBAL_RATE_LIMIT=
# A visitor may seed demo data once per this many minutes [60]; seeds per UTC day [10]
SEED_SESSION_INTERVAL_MINUTES=
SEED_DAILY_CAP=
# Approved actions running at the same time [2]
EXECUTION_CONCURRENCY=

# JPY per 1 USD for price estimates (default 150)
FX_JPY_PER_USD=
# Shown on invoices and the PayPal checkout page
SELLER_BUSINESS_NAME=
# Public URL of this app, used for PayPal return/cancel URLs (default http://localhost:PORT)
PUBLIC_BASE_URL=
# Sandbox personal (buyer) account emails for "Seed demo data", comma-separated
DEMO_BUYER_EMAILS=
# Trusted proxies in front of the app: 0 (default) = use the socket address;
# N = use the N-th X-Forwarded-For entry from the right. One platform proxy (e.g. Render) = 1.
TRUST_PROXY_HOPS=
# AG Studio licence key for the dashboard (next pass); empty shows a watermark
AG_STUDIO_LICENSE=
# Concurrent in-flight API/webhook requests before new ones get 503 (default 20)
MAX_CONCURRENT_REQUESTS=
# HTTP port (default 3000)
PORT=
