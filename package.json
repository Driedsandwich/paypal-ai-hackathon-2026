{
  "name": "paypal-ai-hackathon-2026",
  "version": "0.1.0",
  "private": true,
  "description": "Okuri: an AI export desk for small Japanese sellers, with PayPal (PayPal AI Hackathon 2026 entry)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "start": "node dist/server.js",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublish-check": "node scripts/prepublish-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.137",
    "@ai-sdk/google": "3.0.140",
    "@ai-sdk/openai": "3.0.135",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@fontsource/noto-serif-jp": "5.3.1",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "ai": "6.0.320",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
